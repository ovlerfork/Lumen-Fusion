<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>
  <string>dev.jayl.lumina</string>
  <key>CFBundleName</key>
  <string>Lumina</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>This app requires access to your microphone to stream audio.</string>
  <key>NSLocalNetworkUsageDescription</key>
  <string>Lumina advertises itself on your local network via Bonjour so Moonlight clients can discover this host.</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_nvstream._tcp</string>
  </array>
</dict>
</plist>
